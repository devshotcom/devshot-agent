# DevShot Firecracker backend — ARM64 Docker image
# Tag: anticipatercom/devshot:arm64-fc
# Spec 038 FR-004, FR-015, FR-020.
#
# Smallest image (~150 MB): firecracker + jailer + Go agent + base guest.
# No Xen, no QEMU.

ARG DEVSHOT_FC_PLATFORM=linux/arm64
ARG BASE_IMAGE=anticipatercom/devshot:arm64
FROM --platform=${DEVSHOT_FC_PLATFORM} ${BASE_IMAGE} AS artifacts

# Firecracker release download (pinned version + hash).
FROM --platform=${DEVSHOT_FC_PLATFORM} debian:bookworm-slim AS fc-download
ARG FC_VERSION=1.10.1
ARG FC_ARCH=aarch64
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
  && curl -fsSL -o /tmp/firecracker.tgz \
     "https://github.com/firecracker-microvm/firecracker/releases/download/v${FC_VERSION}/firecracker-v${FC_VERSION}-${FC_ARCH}.tgz" \
  && tar xzf /tmp/firecracker.tgz -C /tmp \
  && mv /tmp/release-v${FC_VERSION}-${FC_ARCH}/firecracker-v${FC_VERSION}-${FC_ARCH} /usr/bin/firecracker \
  && mv /tmp/release-v${FC_VERSION}-${FC_ARCH}/jailer-v${FC_VERSION}-${FC_ARCH} /usr/bin/jailer \
  && chmod +x /usr/bin/firecracker /usr/bin/jailer \
  && rm -rf /tmp/*

FROM --platform=${DEVSHOT_FC_PLATFORM} debian:bookworm-slim

ARG SOURCE_SHA
RUN printf '%s' "$SOURCE_SHA" | grep -Eq '^[0-9a-f]{40}$'
LABEL org.opencontainers.image.revision="$SOURCE_SHA"

RUN apt-get update && apt-get install -y --no-install-recommends \
  qemu-utils \
  iproute2 \
  bridge-utils \
  nftables \
  iptables \
  e2fsprogs \
  util-linux \
  procps \
  file \
  tini \
  socat \
  ca-certificates \
  clamav \
  clamav-freshclam \
  yara \
  && rm -rf /var/lib/apt/lists/*

# Firecracker + jailer binaries.
COPY --from=fc-download /usr/bin/firecracker /usr/bin/firecracker
COPY --from=fc-download /usr/bin/jailer /usr/bin/jailer

# Firecracker aarch64 boots the PE-formatted Linux arm64 Image produced by
# the shared kernel builder. It is published under a backend-specific name so
# a compressed/renamed Xen artifact can never silently satisfy this COPY.
COPY --from=artifacts /xen/boot/vmlinux-domu-fc /xen/boot/vmlinux-domu-fc
RUN test -s /xen/boot/vmlinux-domu-fc && \
  file /xen/boot/vmlinux-domu-fc | grep -Eq 'Linux kernel ARM64|ARM aarch64|PE32\+.*Aarch64'

# The immutable qcow2 is the source artifact. VMManager converts the exact
# selected image to a per-VM raw rootfs under its durable create intent before
# Firecracker starts, then validates and cleans that raw lifecycle explicitly.
COPY --from=artifacts /xen/devshot-guest-base.qcow2 /xen/devshot-guest-base.qcow2
RUN mkdir -p /xen/guests/templates /opt/devshot/templates
COPY --from=artifacts /xen/guests/templates/ /opt/devshot/templates/
RUN cp -a /opt/devshot/templates/. /xen/guests/templates/

COPY bin/devshot-agent-linux-arm64 /opt/devshot/agent
RUN chmod +x /opt/devshot/agent

COPY yara_rules /opt/devshot/yara_rules

COPY docker/load-credentials.sh /opt/devshot/load-credentials.sh
COPY docker/sync-templates.sh /opt/devshot/sync-templates.sh
COPY docker/entrypoint-vmm-fc.sh /opt/devshot/entrypoint.sh
RUN chmod +x /opt/devshot/entrypoint.sh /opt/devshot/load-credentials.sh /opt/devshot/sync-templates.sh

RUN mkdir -p /xen/fc /xen/guests /xen/configs /tmp/xenstore-dom0 /var/run/netns /var/lib/devshot /var/lib/clamav && \
  freshclam --stdout || echo "freshclam failed during image build (non-fatal)"

USER root
ENTRYPOINT ["tini", "--", "/opt/devshot/entrypoint.sh"]
