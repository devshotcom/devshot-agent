# =============================================================================
# DevShot Orchestrator — ARM64 Xen VM orchestrator
#
# Compiles Xen hypervisor + tools/libs, patched QEMU-Xen (required for TCG),
# Linux kernel, and Dom0 rootfs from source. Consumes a pre-built Go agent
# from bin/devshot-agent-linux-arm64 — no Go source in the build context.
#
# Single source of truth for both local dev (scripts/dev.sh compiles the Go
# binary into bin/ then runs this Dockerfile) and CI (build-images.yml in
# devshot-agent does the same).
#
# NOTE: Cross-compiles ARM64 kernel/Xen from an x86 builder stage — works
# on any Docker host regardless of the host arch.
#
# Build:
#   docker buildx build --platform linux/arm64 \
#     -t anticipatercom/devshot:arm64 -f docker/Dockerfile.dom0-arm .
#
# Run:
#   docker run -d --privileged \
#     -e DEVSHOT_SERVER_ID=... -e DEVSHOT_HMAC_SECRET=... \
#     -e DEVSHOT_TUNNEL_URL=wss://console.devshot.com \
#     anticipatercom/devshot:arm64
# =============================================================================

# ─── Stage 1: Build Xen hypervisor + tools/libs ────────────────────────────
FROM debian:bookworm AS xen-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y \
    build-essential \
    bison flex python3 python3-dev \
    uuid-dev libglib2.0-dev libpixman-1-dev \
    libyajl-dev libfdt-dev libssl-dev \
    gcc-aarch64-linux-gnu \
    git wget bc iasl pkg-config libncurses-dev

WORKDIR /build

RUN --mount=type=cache,target=/build/xen,id=xen-src \
    if [ ! -d /build/xen/.git ]; then \
        git clone --depth 1 --branch RELEASE-4.17.5 \
            https://xenbits.xen.org/git-http/xen.git /build/xen; \
    fi && \
    cd /build/xen && \
    if [ ! -f xen/.config ]; then make -C xen XEN_TARGET_ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- defconfig; fi && \
    make -C xen XEN_TARGET_ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- -j$(nproc) && \
    cp xen/xen /tmp/xen-arm64 && \
    ./configure --disable-docs --disable-stubdom && \
    make -C tools/include install && \
    make -C tools/libs install && \
    ldconfig && \
    make -C tools/firmware -j$(nproc) 2>/dev/null || true && \
    make -C tools/firmware install 2>/dev/null || true && \
    mkdir -p /tmp/xen-firmware && \
    (cp -a /usr/local/lib/xen/boot/* /tmp/xen-firmware/ 2>/dev/null || true) && \
    find /usr/local/include /usr/local/lib -name 'xen*' -o -name 'libxen*' -o -name '_libxl*' | \
        tar czf /tmp/xen-dev.tar.gz -T -

# ─── Stage 2: Build QEMU with Xen device model ─────────────────────────────
FROM debian:bookworm AS qemu-xen-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y \
    build-essential python3 ninja-build pkg-config \
    libglib2.0-dev libpixman-1-dev libfdt-dev \
    libyajl-dev zlib1g-dev libaio-dev \
    git flex bison

WORKDIR /build

COPY --from=xen-builder /tmp/xen-dev.tar.gz /tmp/xen-dev.tar.gz
RUN tar xzf /tmp/xen-dev.tar.gz -C / && ldconfig && rm /tmp/xen-dev.tar.gz

RUN --mount=type=cache,target=/build/qemu-xen,id=qemu-xen-src \
    if [ ! -d /build/qemu-xen/.git ]; then \
        git clone --depth 1 --branch stable-4.17 \
            https://xenbits.xen.org/git-http/qemu-xen.git /build/qemu-xen; \
    fi && \
    cd /build/qemu-xen && rm -rf build && \
    ./configure \
        --target-list=aarch64-softmmu \
        --enable-xen \
        --disable-docs \
        --disable-guest-agent \
        --disable-guest-agent-msi \
        --disable-brlapi \
        --disable-curl \
        --disable-curses \
        --disable-sdl \
        --disable-gtk \
        --disable-opengl \
        --enable-vnc \
        --disable-spice \
        --disable-virglrenderer \
        --disable-smartcard \
        --disable-usb-redir \
        --disable-libusb \
        --disable-vhost-user \
        --disable-capstone \
        --disable-libssh \
        --disable-glusterfs \
        --disable-rbd \
        --disable-rdma \
        --disable-vde \
        --disable-nettle \
        --disable-gcrypt \
        --disable-gnutls \
        --disable-tpm \
        --disable-live-block-migration \
        --disable-replication \
        --disable-numa \
        --disable-membarrier \
        --disable-debug-info \
    && make -j$(nproc) && \
    cp build/qemu-system-aarch64 /tmp/qemu-system-aarch64-xen

# ─── Stage 3: Build Linux kernel (Dom0) ────────────────────────────────────
FROM debian:bookworm AS kernel-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y \
    build-essential bc bison flex \
    libssl-dev libelf-dev \
    gcc-aarch64-linux-gnu \
    git wget cpio

WORKDIR /build

RUN --mount=type=cache,target=/build/linux,id=linux-src \
    if [ ! -d /build/linux/.git ]; then \
        git clone --depth 1 --branch linux-6.1.y \
            https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git /build/linux; \
    fi && \
    cd /build/linux && \
    make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- defconfig && \
    scripts/config \
        --enable CONFIG_XEN \
        --enable CONFIG_XEN_DOM0 \
        --enable CONFIG_XEN_BLKDEV_BACKEND \
        --enable CONFIG_XEN_BLKDEV_FRONTEND \
        --enable CONFIG_XEN_NETDEV_BACKEND \
        --enable CONFIG_XEN_NETDEV_FRONTEND \
        --enable CONFIG_XEN_PCIDEV_BACKEND \
        --enable CONFIG_XEN_BALLOON \
        --enable CONFIG_XEN_GNTDEV \
        --enable CONFIG_XEN_GRANT_DEV_ALLOC \
        --enable CONFIG_VIRTIO_BLK \
        --enable CONFIG_VIRTIO_NET \
        --enable CONFIG_VIRTIO_PCI \
        --enable CONFIG_VIRTIO_MMIO \
        --enable CONFIG_EXT4_FS \
        --enable CONFIG_TMPFS \
        --enable CONFIG_DEVTMPFS \
        --enable CONFIG_DEVTMPFS_MOUNT \
        --enable CONFIG_CGROUPS \
        --enable CONFIG_OVERLAY_FS \
        --enable CONFIG_NFSD \
        && \
    scripts/config \
        --set-val CONFIG_BLK_DEV_NBD y \
        --set-val CONFIG_BRIDGE y \
        --set-val CONFIG_VETH y \
        --set-val CONFIG_TUN y \
        --set-val CONFIG_NETFILTER y \
        --set-val CONFIG_NETFILTER_XTABLES y \
        --set-val CONFIG_NF_CONNTRACK y \
        --set-val CONFIG_NF_NAT y \
        --set-val CONFIG_NF_TABLES y \
        --set-val CONFIG_NF_TABLES_IPV4 y \
        --set-val CONFIG_NFT_COMPAT y \
        --set-val CONFIG_NFT_NAT y \
        --set-val CONFIG_NFT_MASQ y \
        --set-val CONFIG_NFT_CHAIN_NAT y \
        --set-val CONFIG_NFT_CT y \
        --set-val CONFIG_NFT_REJECT y \
        --set-val CONFIG_BRIDGE_NETFILTER y \
        --set-val CONFIG_IP_NF_IPTABLES y \
        --set-val CONFIG_IP_NF_FILTER y \
        --set-val CONFIG_IP_NF_NAT y \
        --set-val CONFIG_IP_NF_TARGET_MASQUERADE y \
        --set-val CONFIG_NF_CONNTRACK_IPV4 y && \
    make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- olddefconfig && \
    sed -i 's/CONFIG_BRIDGE=m/CONFIG_BRIDGE=y/; s/CONFIG_BRIDGE_NETFILTER=m/CONFIG_BRIDGE_NETFILTER=y/; s/CONFIG_VETH=m/CONFIG_VETH=y/; s/CONFIG_TUN=m/CONFIG_TUN=y/; s/CONFIG_BLK_DEV_NBD=m/CONFIG_BLK_DEV_NBD=y/; s/CONFIG_NETFILTER_XT_MATCH_STATE=m/CONFIG_NETFILTER_XT_MATCH_STATE=y/; s/CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m/CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y/' .config && \
    make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- -j$(nproc) Image modules && \
    cp arch/arm64/boot/Image /tmp/Image-dom0 && \
    mkdir -p /tmp/modules && \
    make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- INSTALL_MOD_PATH=/tmp/modules modules_install

# ─── Stage 4: Build Dom0 rootfs (Debian Bookworm) ──────────────────────────
FROM debian:bookworm AS rootfs-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y \
    debootstrap qemu-utils e2fsprogs kpartx

WORKDIR /build

RUN --mount=type=cache,target=/var/cache/bootstrap,id=debootstrap \
    debootstrap \
    --include=systemd,systemd-sysv,openssh-server,sudo,iproute2,bridge-utils,dnsmasq,net-tools,iputils-ping,curl,wget,vim-tiny,ca-certificates,gnupg,less,procps,kmod,udev,e2fsprogs,xfsprogs,parted,qemu-utils,iptables,nftables,conntrack,clamav,clamav-daemon,clamav-freshclam,yara \
    bookworm /rootfs http://deb.debian.org/debian

RUN chroot /rootfs bash -c ' \
    echo "deb http://deb.debian.org/debian bookworm main" > /etc/apt/sources.list && \
    echo "deb http://deb.debian.org/debian bookworm-updates main" >> /etc/apt/sources.list && \
    echo "deb http://security.debian.org/debian-security bookworm-security main" >> /etc/apt/sources.list && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        xen-utils-common xen-tools \
        bridge-utils dnsmasq openssh-server tmux \
        sudo iproute2 net-tools iputils-ping \
        curl wget vim-tiny ca-certificates \
        procps kmod udev systemd systemd-sysv \
        python3 qemu-utils nbd-client \
        libpixman-1-0 \
    && rm -rf /var/lib/apt/lists/*'

COPY --from=qemu-xen-builder /tmp/qemu-system-aarch64-xen /rootfs/usr/bin/qemu-system-aarch64
RUN chmod +x /rootfs/usr/bin/qemu-system-aarch64

COPY --from=xen-builder /tmp/xen-dev.tar.gz /tmp/xen-dev.tar.gz
RUN tar xzf /tmp/xen-dev.tar.gz -C /rootfs && \
    chroot /rootfs ldconfig && \
    rm /tmp/xen-dev.tar.gz

COPY --from=xen-builder /tmp/xen-firmware/ /tmp/xen-firmware/
RUN mkdir -p /rootfs/usr/lib/xen/boot /rootfs/usr/local/lib/xen/boot && \
    cp -a /tmp/xen-firmware/* /rootfs/usr/lib/xen/boot/ 2>/dev/null || true && \
    cp -a /tmp/xen-firmware/* /rootfs/usr/local/lib/xen/boot/ 2>/dev/null || true && \
    rm -rf /tmp/xen-firmware

COPY --from=kernel-builder /tmp/modules/lib/modules /rootfs/lib/modules

COPY roles/dom0/files/configure-dom0.sh /tmp/configure-dom0.sh
RUN chmod +x /tmp/configure-dom0.sh && /tmp/configure-dom0.sh /rootfs xen-dom0

RUN mkdir -p /rootfs/xen/guests /rootfs/etc/xen/guests /rootfs/etc/xen/auto /rootfs/xen/boot /rootfs/xen/configs

# ClamAV: download virus signatures outside chroot (chroot has no DNS), then copy in
RUN apt-get update && apt-get install -y clamav 2>/dev/null && \
    freshclam --stdout --datadir=/tmp/clamav-db || echo "freshclam failed (non-fatal)" && \
    mkdir -p /rootfs/var/lib/clamav && \
    cp /tmp/clamav-db/*.cvd /rootfs/var/lib/clamav/ 2>/dev/null || true && \
    rm -rf /tmp/clamav-db

# ClamAV: configure clamd daemon + enable at boot
RUN chroot /rootfs bash -c ' \
    mkdir -p /var/log/clamav && chown clamav:clamav /var/log/clamav && \
    chown -R clamav:clamav /var/lib/clamav && \
    sed -i "s/^Example/#Example/" /etc/clamav/clamd.conf && \
    systemctl enable clamav-daemon 2>/dev/null || true'

# YARA: deploy rules
COPY yara_rules /rootfs/opt/devshot/yara_rules

# Convert rootfs to qcow2 using mke2fs -d (no loop mount / no privileged needed)
RUN cd /rootfs && tar czf /build/dom0-rootfs.tar.gz . && \
    apt-get update && apt-get install -y qemu-utils && \
    mke2fs -t ext4 -d /rootfs -r 1 -N 0 -m 5 -L '' -O ^64bit /tmp/disk.raw 4G && \
    qemu-img convert -f raw -O qcow2 -c /tmp/disk.raw /tmp/dom0-rootfs.qcow2 && \
    rm /tmp/disk.raw

# (No Go builder stage — agent is pre-compiled into bin/devshot-agent-linux-arm64
#  by scripts/dev.sh locally or by build-agent.yml in CI. This Dockerfile
#  never sees Go source.)

# ─── Stage 5: Build DomU guest base image (Alpine rootfs for pool VMs) ────
# Uses native arm64 Alpine to install packages (QEMU user-mode handles cross-arch),
# then exports rootfs as tarball. Config files that Docker bind-mounts read-only
# (/etc/hosts, /etc/hostname, /etc/resolv.conf) are patched in the converter stage.
FROM --platform=linux/arm64 alpine:3.23 AS domu-rootfs

RUN apk add --no-cache \
    alpine-base openssh openrc e2fsprogs xe-guest-utilities \
    qemu-guest-agent \
    iputils sudo tmux curl bash openssl

# SSH config + host keys
RUN mkdir -p /etc/ssh && \
    printf 'Port 22\nPermitRootLogin yes\nPasswordAuthentication yes\nPubkeyAuthentication yes\nAuthorizedKeysFile .ssh/authorized_keys\nSubsystem sftp /usr/lib/ssh/sftp-server\n' > /etc/ssh/sshd_config && \
    ssh-keygen -A 2>/dev/null || true

# Root password (random) + SSH dir
RUN HASH=$(openssl passwd -6 "$(openssl rand -hex 16)") && \
    sed -i "s|^root:.*|root:${HASH}:18000:0:99999:7:::|" /etc/shadow && \
    mkdir -p /root/.ssh && chmod 700 /root/.ssh && \
    touch /root/.ssh/authorized_keys && chmod 600 /root/.ssh/authorized_keys

# Devshot user (unprivileged, passwordless sudo — disposable sandbox).
# Account is unlocked with a random, unknown password so sudo NOPASSWD works
# without leaving an empty password that would allow passwordless console/SSH
# login. A human can set a real password later if interactive access is needed.
RUN adduser -D -s /bin/sh -h /home/devshot devshot && \
    mkdir -p /home/devshot/workspace && \
    chown -R devshot:devshot /home/devshot && \
    mkdir -p /etc/sudoers.d && \
    echo "devshot ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/devshot && \
    chmod 440 /etc/sudoers.d/devshot && \
    grep -q "^#includedir /etc/sudoers.d" /etc/sudoers 2>/dev/null || echo "#includedir /etc/sudoers.d" >> /etc/sudoers && \
    RANDPW=$(head -c 32 /dev/urandom | base64 | tr -d '/+= \n') && \
    echo "devshot:${RANDPW}" | chpasswd && \
    unset RANDPW

# OpenRC services
RUN mkdir -p /etc/runlevels/sysinit /etc/runlevels/boot /etc/runlevels/default && \
    for svc in devfs dmesg mdev hwdrivers; do ln -sf /etc/init.d/$svc /etc/runlevels/sysinit/$svc 2>/dev/null || true; done && \
    for svc in hostname networking bootmisc syslog; do ln -sf /etc/init.d/$svc /etc/runlevels/boot/$svc 2>/dev/null || true; done && \
    ln -sf /etc/init.d/sshd /etc/runlevels/default/sshd && \
    ln -sf /etc/init.d/qemu-guest-agent /etc/runlevels/default/qemu-guest-agent 2>/dev/null || true

# Network + inittab + xennet init + agent init (files Docker doesn't bind-mount)
RUN mkdir -p /etc/network && \
    printf 'auto lo\niface lo inet loopback\n\nauto eth0\niface eth0 inet manual\n' > /etc/network/interfaces && \
    printf '::sysinit:/sbin/openrc sysinit\n::sysinit:/sbin/openrc boot\n::wait:/sbin/openrc default\ntty0::respawn:/sbin/getty -L 38400 tty0 vt100\n::once:/bin/sh -c "[ -e /dev/hvc0 ] && exec /sbin/getty -L 38400 hvc0 vt100 || true"\nttyAMA0::respawn:/bin/sh -l\nttyS0::once:/bin/sh -l\n::ctrlaltdel:/sbin/reboot\n::shutdown:/sbin/openrc shutdown\n' > /etc/inittab && \
    echo '/dev/xvda / ext4 rw,relatime 0 1' > /etc/fstab && \
    printf '#!/sbin/openrc-run\n\nname="xennet"\ndescription="Configure eth0 from xenstore-assigned IP"\n\ndepend() {\n    need net\n    before networking sshd domu-agent\n    after devfs mdev\n}\n\nread_file_xenstore_ip() {\n    local xs_root=""\n    xs_root="${XS_ROOT:-}"\n    if [ -z "$xs_root" ] && [ -r /proc/cmdline ]; then\n        xs_root=$(sed -n "s/.*[[:space:]]XS_ROOT=\\([^[:space:]]*\\).*/\\1/p" /proc/cmdline | head -n1)\n    fi\n    [ -n "$xs_root" ] || xs_root="/tmp/xenstore"\n\n    case "$xs_root" in\n        /mnt/devshot-config/xenstore)\n            mkdir -p /mnt/devshot-config\n            mount -o ro /dev/vdb /mnt/devshot-config 2>/dev/null || true\n            ;;\n        *)\n            modprobe 9p 2>/dev/null || true\n            modprobe 9pnet_virtio 2>/dev/null || true\n            mkdir -p "$xs_root"\n            mount -t 9p -o trans=virtio,version=9p2000.L xen_shared "$xs_root" 2>/dev/null || true\n            ;;\n    esac\n\n    [ -r "$xs_root/local__domain__1__data__ip" ] || return 1\n    cat "$xs_root/local__domain__1__data__ip" 2>/dev/null\n}\n\nstart() {\n    local ip=""\n    local attempts=0\n\n    while [ -z "$ip" ] && [ $attempts -lt 50 ]; do\n        if command -v xenstore-read >/dev/null 2>&1; then\n            ip=$(xenstore-read "data/ip" 2>/dev/null) || ip=""\n        fi\n        if [ -z "$ip" ]; then\n            ip=$(read_file_xenstore_ip) || ip=""\n        fi\n        if [ -z "$ip" ]; then\n            attempts=$((attempts + 1))\n            usleep 100000 2>/dev/null || sleep 0.1\n        fi\n    done\n    if [ -z "$ip" ]; then\n        ebegin "Configuring eth0 via DHCP (last resort)"\n        udhcpc -i eth0 -q -n -t 5 2>/dev/null && eend 0 && return 0\n        ewarn "No IP found in xenstore or DHCP, falling back to 10.10.0.100"\n        ip="10.10.0.100"\n    fi\n    ebegin "Configuring eth0 with ${ip}"\n    ip addr flush dev eth0 2>/dev/null\n    ip addr add ${ip}/16 dev eth0\n    ip link set eth0 up\n    ip route add default via 10.10.0.1 dev eth0 2>/dev/null\n    eend $?\n}\n' > /etc/init.d/xennet && \
    chmod 755 /etc/init.d/xennet && \
    ln -sf /etc/init.d/xennet /etc/runlevels/boot/xennet

# Minimal agent binary for pool VMs (terminal, benchmark, VNC desktop, tunnel).
# Security monitoring and command execution are handled by dom0.
# KVM VMs use agentless xl console proxy instead.
RUN mkdir -p /opt/devshot
COPY bin/devshot-agent-linux-arm64 /opt/devshot/agent
COPY docker/start-agent.sh /opt/devshot/start-agent.sh
RUN chmod 755 /opt/devshot/agent /opt/devshot/start-agent.sh && \
    chmod 700 /opt/devshot && \
    printf '#!/sbin/openrc-run\n\nname="devshot-agent"\ndescription="DevShot Agent"\ncommand="/opt/devshot/start-agent.sh"\npidfile="/run/${RC_SVCNAME}.pid"\ncommand_background="yes"\noutput_log="/var/log/devshot-agent.log"\nerror_log="/var/log/devshot-agent.log"\ncommand_user="root"\n\ndepend() {\n    need net\n    after networking\n}\n' > /etc/init.d/devshot-agent && \
    chmod 755 /etc/init.d/devshot-agent && \
    ln -sf /etc/init.d/devshot-agent /etc/runlevels/default/devshot-agent

# Export rootfs as tarball (exclude Docker-managed pseudo-filesystems)
RUN tar czf /tmp/domu-rootfs.tar.gz --exclude='./tmp' --exclude='./proc' --exclude='./sys' --exclude='./dev' -C / .

# ─── Stage 5c: Convert DomU rootfs to qcow2 (on x86, no emulation needed) ─
FROM debian:bookworm AS domu-converter

RUN apt-get update && apt-get install -y --no-install-recommends qemu-utils e2fsprogs && \
    rm -rf /var/lib/apt/lists/*

COPY --from=domu-rootfs /tmp/domu-rootfs.tar.gz /tmp/domu-rootfs.tar.gz

# Extract rootfs, patch Docker-managed files, then create qcow2 disk image
RUN mkdir -p /domu/rootfs && \
    tar xzf /tmp/domu-rootfs.tar.gz -C /domu/rootfs && \
    rm /tmp/domu-rootfs.tar.gz && \
    echo 'devshot-guest' > /domu/rootfs/etc/hostname && \
    echo '127.0.0.1 localhost devshot-guest' > /domu/rootfs/etc/hosts && \
    echo 'nameserver 10.10.0.1' > /domu/rootfs/etc/resolv.conf && \
    mkdir -p /domu/rootfs/tmp /domu/rootfs/proc /domu/rootfs/sys /domu/rootfs/dev && \
    mke2fs -t ext4 -d /domu/rootfs -r 1 -N 0 -m 5 -L rootfs -O ^64bit /tmp/domu-disk.raw 2G && \
    qemu-img convert -f raw -O qcow2 -c /tmp/domu-disk.raw /tmp/devshot-guest-base.qcow2 && \
    rm -rf /tmp/domu-disk.raw /domu/rootfs

# ─── Stage 6: Final image ──────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    qemu-system-arm qemu-efi-aarch64 qemu-utils \
    socat netcat-openbsd tmux \
    curl ca-certificates bash tini \
    # Spec 038 FR-015 sandbox toolchain — util-linux gives us `unshare` and
    # `setpriv`; systemd-container provides `systemd-run --user --scope` for
    # the cgroup v2 wrapper; apparmor-utils ships `aa-exec` for the optional
    # per-VM AppArmor profile load. devshot-sandbox-init handles the rest
    # (pivot_root, bind mounts, seccomp, cap drop) directly via x/sys/unix
    # — no libseccomp needed because the helper loads precompiled BPF.
    util-linux systemd-container apparmor-utils \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Xen hypervisor + kernel + rootfs (from build stages)
RUN mkdir -p /xen/boot /xen/configs /xen/work /xen/guests /etc/xen/guests /var/lib/xen/guests
COPY --from=xen-builder      /tmp/xen-arm64                   /xen/xen
COPY --from=kernel-builder   /tmp/Image-dom0                   /xen/Image
COPY --from=kernel-builder   /tmp/Image-dom0                   /xen/boot/Image-domu
COPY --from=rootfs-builder   /tmp/dom0-rootfs.qcow2            /xen/dom0-rootfs.qcow2
COPY --from=domu-converter   /tmp/devshot-guest-base.qcow2     /xen/devshot-guest-base.qcow2
COPY                         roles/dom0/files/boot-xen.sh      /xen/boot-xen.sh
RUN chmod +x /xen/boot-xen.sh

# Go agent binary
WORKDIR /opt/devshot
COPY bin/devshot-agent-linux-arm64 ./agent

# Spec 038 FR-015 sandbox helper — runs inside the per-VM mount namespace
# (after unshare) and applies pivot_root + bind mounts + seccomp + cap
# drop before exec'ing the VM binary. Sandbox.Wrap looks for it at
# /usr/local/bin/devshot-sandbox-init by default; SANDBOX_INIT_BIN can
# override for tests.
COPY bin/devshot-sandbox-init-linux-arm64 /usr/local/bin/devshot-sandbox-init
RUN chmod 755 /usr/local/bin/devshot-sandbox-init

# Entrypoint
COPY docker/entrypoint-dom0-arm.sh ./entrypoint.sh
RUN chmod +x /opt/devshot/entrypoint.sh

# Tunables
# Hardware-sensitive values (XEN_MEM, XEN_CPUS, VM_MEM, DOM0_MEM) are intentionally
# NOT set here — the entrypoint auto-detects host resources at runtime and sizes
# Xen to use the full machine by default. Override per-run with -e XEN_MEM=...
ENV PORT=7200 \
    BIND_HOST=0.0.0.0 \
    POOL_SIZE=2 \
    LOG_LEVEL=info

ENTRYPOINT ["tini", "--"]
CMD ["/opt/devshot/entrypoint.sh"]
