[Unit]
Description=DevShot QEMU orchestrator
After=local-fs.target network.target
Wants=network.target

[Service]
Type=simple
PassEnvironment=DEVSHOT_SERVER_ID DEVSHOT_HMAC_SECRET DEVSHOT_TUNNEL_URL DEVSHOT_CREDENTIALS_FILE
PassEnvironment=DEVSHOT_CONSOLE_URL DEVSHOT_BROWSER_ORIGIN DEVSHOT_DEVICE_KEY DEVSHOT_ENV DEVSHOT_PPROF_ADDR
PassEnvironment=DEVSHOT_SERVER_LAT DEVSHOT_SERVER_LON DEVSHOT_SERVER_CITY DEVSHOT_SERVER_COUNTRY DEVSHOT_SERVER_COUNTRY_CODE
PassEnvironment=DEVSHOT_SHELL_ONLY_ALLOW_HOSTS DEVSHOT_TLS_SKIP DEVSHOT_STRICT_ACCEL DEVSHOT_QEMU_BIN
PassEnvironment=LAMP_RELEASE_INDEX_URL LAMP_RELEASE_TOKEN LAMP_SYNC_INTERVAL LAMP_SYNC_DOWNLOAD_TIMEOUT
PassEnvironment=GUESTS_DIR CONFIGS_DIR DEVSHOT_DATA_DIR BASE_IMAGE KERNEL RAMDISK
PassEnvironment=BRIDGE BRIDGE_PREFIX BRIDGE_SUBNET BRIDGE_MASK GATEWAY_IP IP_START IP_END
PassEnvironment=NBD_MAX DEVSHOT_NBD_COUNT VM_MEM VM_CPUS PUBLIC_POOL_SIZE POOL_FILL_WORKERS
PassEnvironment=IDLE_TTL_MS READY_TIMEOUT REAPER_INTERVAL SCAN_INTERVAL_MS SCAN_INITIAL_DELAY_MS
PassEnvironment=WEBRTC_STUN_URL WEBRTC_TURN_URL WEBRTC_TURN_SECRET WEBRTC_FORCE_RELAY
PassEnvironment=OBJSTORE_ENDPOINT OBJSTORE_REGION OBJSTORE_ACCESS_KEY OBJSTORE_SECRET_KEY OBJSTORE_FORCE_PATH_STYLE
PassEnvironment=LOG_LEVEL BAKE_APK_CACHE_DIR SCAN_PROCESS_NICE SCAN_YARA_THREADS SCAN_MAX_LOAD_5
ExecStart=/opt/devshot/entrypoint.sh
Restart=on-failure
RestartSec=5s
Delegate=yes
KillMode=mixed
TimeoutStopSec=90s
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
