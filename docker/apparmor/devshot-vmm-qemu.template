# devshot-vmm-qemu.template — per-VM AppArmor profile template.
# Instantiated at Create time by vmm_sandbox_linux.go with the
# following substitutions:
#
#   @{VM_NAME}    → spec.Name                          (e.g. "pool-abcd1234")
#   @{VM_ROOT}    → /xen/qemu/<vm-name>               (per-VM runtime dir)
#   @{VM_DISK}    → /xen/guests/<vm-name>.qcow2       (per-VM overlay)
#   @{VM_BACKING} → immutable generation dir or base file (read-only)
#   @{VM_TAP}     → vm-<sha1(name)[:6]>               (tap interface)
#
# The loader writes the expanded profile to
# /etc/apparmor.d/devshot-vmm-qemu-@{VM_NAME} and runs
# `apparmor_parser -r` before execing the VM.
#
# Spec 038 FR-015 — per-VM enforcement, strictest possible scope.

abi <abi/3.0>,
#include <tunables/global>

profile devshot-vmm-qemu-@{VM_NAME} flags=(chroot_relative) {
  #include <abstractions/base>

  # Deny default — only explicit permissions work.
  deny @{HOME}/** rwklmx,
  deny /root/** rwklmx,
  deny /etc/devshot/secrets/** rwklmx,
  deny /proc/*/environ r,
  deny /proc/*/mem rwklmx,
  deny /proc/*/root/** rwklmx,

  # QEMU binary + kernel + base image (read-only).
  /usr/bin/qemu-system-aarch64 rix,
  /usr/bin/qemu-system-x86_64 rix,
  # QEMU resolves its read-only firmware and option ROMs at runtime. Debian
  # keeps x86 firmware below qemu/seabios and AArch64 firmware below AAVMF.
  /usr/share/qemu/** r,
  /usr/share/seabios/** r,
  /usr/share/AAVMF/** r,
  /usr/share/qemu-efi-aarch64/** r,
  /xen/boot/Image-domu r,
  # QEMU also takes shared OFD locks on read-only backing-chain files.
  /xen/devshot-guest-base.qcow2 rk,
  @{VM_BACKING} rk,
  @{VM_BACKING}/ r,
  @{VM_BACKING}/** rk,

  # QEMU enters this profile only after pivot_root. chroot_relative makes
  # AppArmor mediate the private root exactly as QEMU sees it, including the
  # native control directory. Keeping it native avoids AppArmor's disconnected
  # path mediation for a directory bind-mounted from outside the private root.
  # QEMU takes an advisory lock on its PID file; AppArmor models that
  # separately as `k`.
  /run/devshot/ rw,
  /run/devshot/pid rwk,
  # QEMU's virtio-9p local backend stats the exact FileXenstore directory
  # before it can expose the share. AppArmor directory mediation requires a
  # trailing-slash rule; the recursive child rule alone does not grant this
  # directory lookup.
  /run/devshot/xenstore/ rw,
  /run/devshot/** rw,

  # AppArmor mediates filesystem-backed Unix sockets twice: the socket
  # operation here and the pathname through the file rules above. Spell out
  # the stream operations instead of relying on the coarse network-to-unix
  # compatibility mapping; the pathname grant remains confined to this VM's
  # private control directory.
  unix (create, bind, listen, accept, connect, send, receive, getattr, setattr, getopt, setopt, shutdown) type=stream,

  # Per-VM disk overlay. QEMU takes an OFD lock on every writable qcow2;
  # AppArmor models that separately as `k`, just like the PID-file lock.
  @{VM_DISK} rwk,

  # Every other VM runtime and guest disk remains inaccessible by default:
  # AppArmor grants only the exact VM root/disk and backing path above. Do not
  # add a broad explicit deny here; AppArmor denies override narrower allows
  # and would also block this VM's own disk or immutable generation.

  # Block everything outside the VM's namespace.
  deny /xen/agent.env r,
  # Deny rules use bare `x`; AppArmor rejects inherited-exec qualifiers such
  # as `ix` after `deny` before the VM can boot.
  deny /opt/devshot/agent rx,

  # No capabilities inside the VM.
  deny capability,

  # No mount/umount.
  deny mount,
  deny umount,
  deny remount,
  deny pivot_root,

  # KVM device only — no /dev/mem, /dev/kmem, /dev/sda*, /dev/nvme*.
  /dev/kvm rw,
  /dev/net/tun rw,
  /dev/urandom r,
  /dev/null rw,
  /dev/zero r,
  /dev/ptmx rw,
  deny /dev/mem rwklmx,
  deny /dev/kmem rwklmx,
  deny /dev/sd* rwklmx,
  deny /dev/nvme* rwklmx,
  deny /dev/xvd* rwklmx,

  # Networking: virtio over the tap only.
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  network netlink raw,
  deny network bluetooth,
  deny network packet,

  # Proc filesystem: strictly limited.
  /proc/cpuinfo r,
  /proc/meminfo r,
  /proc/filesystems r,
  /proc/self/status r,
  /proc/self/stat r,
  /proc/self/maps r,
  deny /proc/*/environ r,
  deny /proc/sys/kernel/random/boot_id r,
  deny /proc/kcore rwklmx,
}
