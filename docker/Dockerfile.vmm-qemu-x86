# DevShot QEMU/KVM backend — x86_64 Docker image
# Tag: anticipatercom/devshot:amd64-kvm
# See Dockerfile.vmm-qemu-arm for detailed comments; this is the x86 variant.
# Spec 038 FR-003, FR-020.

ARG DEVSHOT_QEMU_PLATFORM=linux/amd64
ARG BASE_IMAGE=anticipatercom/devshot:amd64
FROM --platform=${DEVSHOT_QEMU_PLATFORM} ${BASE_IMAGE} AS artifacts

FROM --platform=${DEVSHOT_QEMU_PLATFORM} debian:bookworm-slim

# The KVM rolling digest is the family commit marker. Keep it cryptographically
# source-unique even when all copied runtime payloads happen to be identical.
ARG SOURCE_SHA
RUN printf '%s' "$SOURCE_SHA" | grep -Eq '^[0-9a-f]{40}$'
LABEL org.opencontainers.image.revision="$SOURCE_SHA" \
      io.devshot.image-family.schema="2"

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
  qemu-system-x86 \
  qemu-utils \
  systemd \
  systemd-sysv \
  dbus \
  iproute2 \
  bridge-utils \
  nftables \
  iptables \
  apparmor \
  apparmor-utils \
  libseccomp2 \
  util-linux \
  tini \
  procps \
  socat \
  ca-certificates \
  dnsmasq \
  kmod \
  conntrack \
  clamav \
  clamav-freshclam \
  yara \
  && rm -rf /var/lib/apt/lists/*

COPY --from=artifacts /xen/boot/Image-domu /xen/boot/Image-domu
COPY --from=artifacts /xen/devshot-guest-base.qcow2 /xen/devshot-guest-base.qcow2
# Pre-baked flavor templates — agent's bakery.ListTemplates() reads this
# directory at startup. Runtime installs bind-mount /xen/guests, so keep
# immutable copies in /opt/devshot/templates and sync them on container boot.
RUN mkdir -p /xen/guests/templates /opt/devshot/templates
COPY --from=artifacts /xen/guests/templates/ /opt/devshot/templates/
# Spec 058 phase 4: LAMP matrix (lamp-shared + 11 per-(app, version)
# variants). Baked separately in build-agent.yml — see the
# `Bake LAMP matrix` step there. Backing chain points each variant at
# lamp-shared.qcow2 by relative filename, so cp -a-ing both into the
# same templates dir preserves the chain at runtime. The directory may
# be absent on a first-ever release (base qcow2 not yet in agent repo);
# `COPY ... || true` isn't a thing in Dockerfile, so we COPY the parent
# dir and let the runtime sync handle a missing lamp/ gracefully.
COPY templates/ /opt/devshot/templates_extra/
RUN if [ -d /opt/devshot/templates_extra/lamp ]; then \
      mv /opt/devshot/templates_extra/lamp/* /opt/devshot/templates/ 2>/dev/null || true; \
    fi && \
    rm -rf /opt/devshot/templates_extra
RUN cp -a /opt/devshot/templates/. /xen/guests/templates/
COPY --from=artifacts /xen/configs/ /xen/configs/

COPY bin/devshot-agent-linux-amd64 /opt/devshot/agent
COPY bin/devshot-sandbox-init-linux-amd64 /usr/local/bin/devshot-sandbox-init
COPY bin/devshot-userns-run-linux-amd64 /usr/local/bin/devshot-userns-run
RUN chmod 0755 /opt/devshot/agent /usr/local/bin/devshot-sandbox-init /usr/local/bin/devshot-userns-run

COPY yara_rules /opt/devshot/yara_rules

COPY docker/apparmor/devshot-vmm-qemu.parent /etc/apparmor.d/devshot-vmm-qemu.parent
COPY docker/apparmor/devshot-vmm-qemu.template /etc/devshot/apparmor/devshot-vmm-qemu.template
COPY docker/seccomp/devshot-vmm.json /etc/devshot/seccomp/devshot-vmm.json

COPY docker/load-credentials.sh /opt/devshot/load-credentials.sh
COPY docker/sync-templates.sh /opt/devshot/sync-templates.sh
COPY docker/entrypoint-vmm-qemu.sh /opt/devshot/entrypoint.sh
COPY docker/devshot-vmm-qemu.service /etc/systemd/system/devshot-vmm-qemu.service
# Debian's dnsmasq package enables its own unit on install. Harmless while tini
# was PID 1 (nothing started it), but systemd boots it — so the packaged
# resolver races the one the orchestrator starts itself in
# entrypoint-vmm-qemu.sh with its own args, both binding the gateway's :53.
# Mask it: the orchestrator execs the dnsmasq BINARY directly, so masking the
# unit costs nothing and is what the VMM integration quiescence scan requires.
RUN chmod +x /opt/devshot/entrypoint.sh /opt/devshot/load-credentials.sh /opt/devshot/sync-templates.sh && \
  systemctl enable devshot-vmm-qemu.service && \
  systemctl mask dnsmasq.service

RUN mkdir -p /xen/qemu /xen/guests /tmp/xenstore-dom0 /var/run/netns /var/lib/clamav && \
  freshclam --stdout || echo "freshclam failed during image build (non-fatal)"

USER root
ENV container=docker
STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/sbin/init"]
