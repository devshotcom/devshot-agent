# DevShot QEMU/KVM backend — ARM64 Docker image
# Tag: anticipatercom/devshot:arm64-kvm
#
# Spec 038 FR-003, FR-020. Ships a minimal container with:
#   - qemu-system-aarch64 (for launching pool VMs directly on KVM)
#   - The pre-built DomU kernel (Image-domu) and base guest qcow2
#   - The Go agent binary
#   - iproute2, bridge-utils, nftables (networking)
#   - apparmor-utils, libseccomp2 (sandbox enforcement)
#
# No Xen, no Dom0 rootfs, no qemu-xen variant. This image is ~400 MB
# vs the Xen image's ~1.2 GB.
#
# Run with:
#   docker run -d --name devshot-<name> \
#     --cap-add=NET_ADMIN --cap-add=SYS_ADMIN \
#     --device=/dev/net/tun --device=/dev/kvm \
#     --read-only --tmpfs /tmp --tmpfs /run --tmpfs /var/run \
#     --network=host --restart=unless-stopped \
#     -v /var/lib/devshot/<name>/credentials.env:/opt/devshot/credentials.env:ro \
#     -e DEVSHOT_SERVER_ID=... \
#     -e DEVSHOT_CREDENTIALS_FILE=/opt/devshot/credentials.env \
#     -e DEVSHOT_TUNNEL_URL=wss://console.devshot.com \
#     anticipatercom/devshot:arm64-kvm

# ── Stage 1: copy artifacts from the Xen image's build stages ──────────────
# We reuse the domu-rootfs and kernel-builder stages from
# Dockerfile.dom0-arm. These stages produce Image-domu (the DomU
# kernel) and devshot-guest-base.qcow2 (the Alpine guest root fs).
# In CI, these are built once and shared across all image variants
# via Docker build-cache or a multi-stage pipeline.
#
# For local builds, you must have built the Xen image first:
#   docker build -t devshot-dom0-arm -f Dockerfile.dom0-arm .
#
# Then this Dockerfile copies artifacts from that image:
ARG BASE_IMAGE=anticipatercom/devshot:arm64
FROM ${BASE_IMAGE} AS artifacts

# ── Stage 2: final image ───────────────────────────────────────────────────
FROM debian:bookworm-slim

# Install runtime deps (minimal).
RUN apt-get update && apt-get install -y --no-install-recommends \
  qemu-system-arm \
  qemu-utils \
  iproute2 \
  bridge-utils \
  nftables \
  iptables \
  apparmor \
  apparmor-utils \
  libseccomp2 \
  util-linux \
  procps \
  tini \
  socat \
  ca-certificates \
  dnsmasq \
  kmod \
  conntrack \
  clamav \
  clamav-freshclam \
  yara \
  && rm -rf /var/lib/apt/lists/*

# Copy pre-built artifacts from the Xen image.
COPY --from=artifacts /xen/boot/Image-domu /xen/boot/Image-domu
COPY --from=artifacts /xen/devshot-guest-base.qcow2 /xen/devshot-guest-base.qcow2
# Pre-baked flavor templates — see Dockerfile.vmm-qemu-x86 for design notes.
RUN mkdir -p /xen/guests/templates /opt/devshot/templates
COPY --from=artifacts /xen/guests/templates/ /opt/devshot/templates/
RUN cp -a /opt/devshot/templates/. /xen/guests/templates/
COPY --from=artifacts /xen/configs/ /xen/configs/

# Copy the Go agent binary (built by CI in the agent-build job).
COPY bin/devshot-agent-linux-arm64 /opt/devshot/agent
RUN chmod +x /opt/devshot/agent

COPY yara_rules /opt/devshot/yara_rules

# Copy security policies.
COPY docker/apparmor/devshot-vmm-qemu.parent /etc/apparmor.d/devshot-vmm-qemu.parent
COPY docker/apparmor/devshot-vmm-qemu.template /etc/devshot/apparmor/devshot-vmm-qemu.template
COPY docker/seccomp/devshot-vmm.json /etc/devshot/seccomp/devshot-vmm.json

# Copy the entrypoint.
COPY docker/load-credentials.sh /opt/devshot/load-credentials.sh
COPY docker/sync-templates.sh /opt/devshot/sync-templates.sh
COPY docker/entrypoint-vmm-qemu.sh /opt/devshot/entrypoint.sh
RUN chmod +x /opt/devshot/entrypoint.sh /opt/devshot/load-credentials.sh /opt/devshot/sync-templates.sh

# Create runtime dirs and prefetch signatures when possible.
RUN mkdir -p /xen/qemu /xen/guests /tmp/xenstore-dom0 /var/run/netns /var/lib/clamav && \
  freshclam --stdout || echo "freshclam failed during image build (non-fatal)"

# Run as unprivileged UID by default (spec 038 FR-020).
# The entrypoint needs root for bridge + iptables; dropping after
# setup is handled by the sandbox layer inside the Go agent.
USER root

ENTRYPOINT ["tini", "--", "/opt/devshot/entrypoint.sh"]
